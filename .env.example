# ===== 访问控制 =====
# 登录密码；不设置则服务仅监听 127.0.0.1 且免登录
AUTH_PASSWORD=
# Cookie 会话签名密钥（设置 AUTH_PASSWORD 时必填，随机长字符串）
SESSION_SECRET=
# 会话有效期（天）
SESSION_DAYS=30

# ===== 服务 =====
PORT=3001
# 同步间隔（分钟）
SYNC_INTERVAL_MIN=15

# ===== 数据源凭据（填了才启用对应真实适配器） =====
# Garmin 美区账号
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Suunto 美区账号（Sports Tracker 后端）
SUUNTO_EMAIL=
SUUNTO_PASSWORD=
# 仅颂拓流量走的代理（sports-tracker 登录接口对 CN 出口 IP 有区域封锁），如 http://127.0.0.1:7890；留空直连
SUUNTO_PROXY=

# ===== AI 教练（阿里云百炼 DashScope，OpenAI 兼容模式） =====
DASHSCOPE_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus
QWEN_ASR_MODEL=qwen3-asr-flash

ICU_API_KEY=

SUUNTO_SESSION_KEY=

# ===== Strava（颂拓接力通道，混合方案） =====
# Strava API 应用（strava.com/settings/api）的 Client ID / Secret；
# 授权回调域填 localhost。连接走设置页 OAuth，refresh token 存库，无需手填。
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# 可选：已有 refresh token 时作种子（正常留空，走设置页连接）
STRAVA_REFRESH_TOKEN=
